{
  "name": "solenexa",
  "version": "0.2.2",
  "description": "Offline footwear production and labour accounts",
  "author": "IQ Links",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "preview": "node tools/preview.cjs",
    "dist": "electron-builder --win nsis portable --x64",
    "test:ui": "electron tools/phase1-ui.cjs"
  },
  "build": {
    "appId": "com.solenexa.desktop",
    "productName": "SoleNexa",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "solenexa-logo.png",
      "iq-links-logo.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "compression": "normal",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.6"
  }
}
